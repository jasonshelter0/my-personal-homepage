# Node 24+. Load with: node --env-file=.env --import tsx server/index.ts
HOST=127.0.0.1
PORT=4321
PREVIEW_PORT=4322
PRODUCTION_PORT=4323
PUBLIC_HOST=127.0.0.1
# For local demo, omitted password defaults to local-demo-password.
# Set a strong password before using a network-facing server.
# ADMIN_PASSWORD=
# COOKIE_SECURE=true
# FOLIO_DATA_DIR=/absolute/path/to/folio-data
# Single-origin HTTPS production gateway behind the existing Nginx:
# NODE_ENV=production
# SERVE_PUBLIC=true
# PUBLIC_ORIGIN=https://www.jasonshelter.com
# PRODUCTION_URL=https://www.jasonshelter.com
# PREVIEW_BASE_PATH=/preview
# HOST=127.0.0.1
# PORT=18080
# NODE_OPTIONS=--max-old-space-size=384
# Production requires a private ADMIN_PASSWORD of at least 20 characters
# and COOKIE_SECURE=true. Keep the SQLite/media/releases data outside the image.
# OpenAI-compatible translation provider. URL includes /v1, without /chat/completions.
# TRANSLATION_BASE_URL=https://your-provider.example/v1
# TRANSLATION_API_KEY=
# TRANSLATION_MODEL=

# MyMemory is available without a key (5000 characters/day anonymous allowance).
# Translation is owner-triggered; selected prose is sent to that external provider.
# Optional LibreTranslate instance; self-hosted instances may not require a key.
# LIBRETRANSLATE_URL=https://your-libretranslate.example
# LIBRETRANSLATE_API_KEY=
