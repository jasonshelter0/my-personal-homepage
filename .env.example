# Node 24+. Load with: node --env-file=.env --import tsx server/index.ts
HOST=127.0.0.1
PORT=4321
PREVIEW_PORT=4322
PRODUCTION_PORT=4323
PUBLIC_HOST=127.0.0.1
# For local demo, omitted password defaults to local-demo-password.
# Set a strong password before using a network-facing server.
# ADMIN_PASSWORD=
# COOKIE_SECURE=true
# FOLIO_DATA_DIR=/absolute/path/to/folio-data
# OpenAI-compatible translation provider. URL includes /v1, without /chat/completions.
# TRANSLATION_BASE_URL=https://your-provider.example/v1
# TRANSLATION_API_KEY=
# TRANSLATION_MODEL=
