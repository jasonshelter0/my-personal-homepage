{
  "name": "folio-studio",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "build:admin": "vite build --config apps/admin/vite.config.ts",
    "build:site": "astro build --root apps/site && pagefind --site apps/site/dist",
    "build": "npm run build:admin && npm run build:site",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "setup": "npm run build:admin && tsx scripts/setup.ts",
    "export": "tsx scripts/export.ts",
    "start:env": "node --env-file=.env --import tsx server/index.ts",
    "format": "prettier --write .",
    "release:prepare": "tsx scripts/prepare-production.ts"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "express": "^5.1.0",
    "marked": "^18.1.1",
    "multer": "^2.5.0",
    "pagefind": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
