+// Lay out complete commit cells (node + references), never just their circles.
+// Coordinates are independent of the phone viewport; the camera fits/zooms them.
+function layoutRows(cells, gap = 28) {
+  const rows = new Map();
+  cells.forEach(cell => {
+    if (!rows.has(cell.depth)) rows.set(cell.depth, []);
+    rows.get(cell.depth).push(cell);
+  });
+  const ordered = [...rows.entries()].sort((a, b) => a[0] - b[0]).map(([, row]) => {
+    row.sort((a, b) => a.order - b.order || a.id.localeCompare(b.id));
+    // A degenerate/custom tree can assign equal columns; separate ties locally.
+    if (row.some((c, i) => i && c.order <= row[i - 1].order)) {
+      row = row.map((c, i) => ({ ...c, order: (i + 1) / (row.length + 1) }));
+    }
+    return { cells: row, top: Math.max(...row.map(c => c.top)), bottom: Math.max(...row.map(c => c.bottom)) };
+  });
+  // Preserve the tree's column alignment, expanding only as much as the labels
+  // require. In particular, a linear history remains a straight vertical line.
+  let span = 80;
+  ordered.forEach(row => row.cells.forEach((cell, i) => {
+    if (!i) return;
+    const previous = row.cells[i - 1];
+    span = Math.max(span, (previous.right + cell.left + gap) / (cell.order - previous.order));
+  }));
+  const all = ordered.flatMap(row => row.cells);
+  const left = all.length ? Math.min(...all.map(c => c.order * span - c.left)) : 0;
+  const right = all.length ? Math.max(...all.map(c => c.order * span + c.right)) : 0;
+  const width = Math.max(260, right - left + 32);
+  const offset = (width - (right - left)) / 2 - left;
+  let y = 48;
+  const positions = {};
+  ordered.forEach(row => {
+    y += row.top;
+    row.cells.forEach(cell => { positions[cell.id] = { x: offset + cell.order * span, y }; });
+    y += row.bottom + 44;
+  });
+  return { positions, width, height: Math.max(160, y - 44 + 24) };
+}
+exports.layoutRows = layoutRows;
