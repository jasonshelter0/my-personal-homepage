+const assert = require('node:assert/strict');
+const path = require('node:path');
+const {pathToFileURL} = require('node:url');
+const {chromium} = require(process.env.PLAYWRIGHT_MODULE || 'playwright');
+const file = pathToFileURL(path.resolve(__dirname,'../dist/git-pocket-offline.html')).href;
+(async()=>{
+  const browser = await chromium.launch();
+  for(const mode of ['getter-denied','writes-denied','dialog-fallback']) {
+    const context = await browser.newContext({viewport:{width:390,height:844},isMobile:true,hasTouch:true,offline:true});
+    await context.addInitScript(mode => {
+      if (mode === 'getter-denied') Object.defineProperty(window,'localStorage',{get(){throw new DOMException('Access denied','SecurityError')}});
+      if (mode === 'writes-denied') Storage.prototype.setItem = function(){throw new DOMException('Storage disabled','QuotaExceededError')};
+      if (mode === 'dialog-fallback') {
+        HTMLDialogElement.prototype.showModal = undefined;
+        HTMLDialogElement.prototype.close = undefined;
+      }
+    },mode);
+    const page = await context.newPage();const errors=[];page.on('pageerror',e=>errors.push(e.message));
+    await page.goto(file);
+    await page.waitForFunction(()=>document.querySelector('#pocketStartup').style.display === 'none');
+    if(mode!=='dialog-fallback') assert(await page.locator('#pocketStorageNotice').isVisible());
+    await page.locator('#commandTextField').fill('git commit');await page.locator('#pocketRun').click();
+    await page.waitForFunction(()=>document.querySelector('#canvasHolder').textContent.includes('C2'));
+    await page.locator('#pocketReference').click();await page.locator('[data-fill="git branch feature"]').click();
+    assert.equal(await page.locator('#commandTextField').inputValue(),'git branch feature');
+    await page.locator('#pocketAbout').click();
+    await page.locator('#pocketImport').setInputFiles({name:'progress.json',mimeType:'application/json',buffer:Buffer.from('{"intro1":{"solved":true,"best":false}}')});
+    await page.waitForFunction(()=>document.getElementById('pocketProgress').textContent.includes('1 关'));
+    const downloaded = page.waitForEvent('download');await page.locator('#pocketExport').click();
+    const download = await downloaded;assert.equal(download.suggestedFilename(),'git-pocket-progress.json');
+    await page.locator('#pocketDialogClose').click();
+    await page.screenshot({path:path.resolve(__dirname,'../test-results/android-'+mode+'.png')});
+    assert.deepEqual(errors,[]);
+    console.log('PASS',mode,': startup, command, reference, progress import/export');
+    await context.close();
+  }
+  const noJS=await browser.newContext({javaScriptEnabled:false,viewport:{width:390,height:844}});
+  const preview=await noJS.newPage();await preview.goto(file);
+  assert(await preview.locator('#pocketStartup').isVisible());
+  assert(await preview.locator('#pocketStartup a').isVisible());
+  console.log('PASS script-disabled preview has readable guidance and online link');
+  const failed=await browser.newPage();await failed.addInitScript(()=>{window.matchMedia=undefined});await failed.goto(file);
+  await failed.waitForFunction(()=>document.getElementById('pocketStartupError').textContent.length>0);
+  assert(await failed.locator('#pocketStartup').isVisible());
+  console.log('PASS startup error produces readable diagnostics');
+  await browser.close();
+})().catch(e=>{console.error(e);process.exit(1)});
