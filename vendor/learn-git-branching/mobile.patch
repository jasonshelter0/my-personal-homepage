+const { layoutRows } = require('../src/js/visuals/graphLayout');
+function bounds(cell, position) {
+  return { left: position.x - cell.left, right: position.x + cell.right,
+    top: position.y - cell.top, bottom: position.y + cell.bottom };
+}
+function verify(cells) {
+  const layout = layoutRows(cells);
+  const boxes = cells.map(cell => bounds(cell, layout.positions[cell.id]));
+  boxes.forEach((box, i) => {
+    expect(box.left).toBeGreaterThanOrEqual(0);
+    expect(box.top).toBeGreaterThanOrEqual(0);
+    expect(box.right).toBeLessThanOrEqual(layout.width);
+    expect(box.bottom).toBeLessThanOrEqual(layout.height);
+    boxes.slice(i + 1).forEach(other => {
+      expect(box.right <= other.left || other.right <= box.left || box.bottom <= other.top || other.bottom <= box.top).toBe(true);
+    });
+  });
+  return layout;
+}
+describe('commit cells with branch/tag/file label footprints', () => {
+  it('separates a wide fan-out without compressing nodes or labels', () => {
+    const cells = Array.from({ length: 8 }, (_, i) => ({ id: 'C' + i, depth: 1, order: i / 8, left: 20, right: 140, top: 20, bottom: 20 }));
+    const layout = verify(cells);
+    expect(layout.width).toBeGreaterThan(1000);
+  });
+  it('reserves space between deep rows with tall reference stacks', () => {
+    const cells = Array.from({ length: 12 }, (_, i) => ({ id: 'C' + i, depth: i, order: .5, left: 20, right: 120, top: i === 4 ? 90 : 20, bottom: i === 4 ? 90 : 20 }));
+    const layout = verify(cells);
+    expect(layout.positions.C5.y - layout.positions.C4.y).toBeGreaterThan(110);
+    expect(layout.positions.C0.x).toBe(layout.positions.C11.x);
+  });
+  it('trims empty margins equally for local and origin coordinate ranges', () => {
+    const cells = [0, 1].map(i => ({ id: 'C' + i, depth: i, order: .25, left: 20, right: 80, top: 20, bottom: 20 }));
+    expect(layoutRows(cells)).toEqual(layoutRows(cells.map(c => ({ ...c, order: .75 }))));
+  });
+  it('keeps files and long ref labels within the camera world, deterministically', () => {
+    const cells = [{ id: 'C0', depth: 0, order: .5, left: 20, right: 20, top: 20, bottom: 20 },
+      { id: 'C1', depth: 1, order: .8, left: 180, right: 420, top: 70, bottom: 70 },
+      { id: 'C2', depth: 1, order: .2, left: 20, right: 100, top: 20, bottom: 20 }];
+    const layout = verify(cells);
+    expect(layout).toEqual(layoutRows([...cells].reverse()));
+    expect(layout.positions.C2.x).toBeLessThan(layout.positions.C1.x);
+  });
+});
