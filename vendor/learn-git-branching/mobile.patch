diff --git a/src/js/util/storage.js b/src/js/util/storage.js
new file mode 100644
index 0000000..cee0b06
--- /dev/null
+++ b/src/js/util/storage.js
@@ -0,0 +1,44 @@
+'use strict';
+
+// Accessing the localStorage property itself can throw for Android content://
+// documents and other opaque origins. Keep the simulator usable in memory.
+function createStorage(getStorage) {
+  var memory = Object.create(null);
+  var nativeStorage = null;
+  try {
+    nativeStorage = getStorage();
+    var probe = '__git_pocket_storage_probe__';
+    nativeStorage.setItem(probe, '1');
+    nativeStorage.removeItem(probe);
+  } catch (error) { nativeStorage = null; }
+  return {
+    isPersistent: function() { return !!nativeStorage; },
+    getItem: function(key) {
+      if (nativeStorage) {
+        try {
+          var value = nativeStorage.getItem(key);
+          if (value !== null) { memory[key] = value; } else { delete memory[key]; }
+          return value;
+        } catch (error) { nativeStorage = null; }
+      }
+      return Object.prototype.hasOwnProperty.call(memory, key) ? memory[key] : null;
+    },
+    setItem: function(key, value) {
+      memory[key] = String(value);
+      if (nativeStorage) {
+        try { nativeStorage.setItem(key, String(value)); }
+        catch (error) { nativeStorage = null; }
+      }
+    },
+    removeItem: function(key) {
+      delete memory[key];
+      if (nativeStorage) {
+        try { nativeStorage.removeItem(key); }
+        catch (error) { nativeStorage = null; }
+      }
+    }
+  };
+}
+var storage = createStorage(function() { return window.localStorage; });
+storage.createStorage = createStorage;
+module.exports = storage;
