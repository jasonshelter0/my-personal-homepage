diff --git a/src/js/mobile/localize.js b/src/js/mobile/localize.js
new file mode 100644
index 0000000..1289e68
--- /dev/null
+++ b/src/js/mobile/localize.js
@@ -0,0 +1,26 @@
+// Shell translations; the upstream engine still supplies level and command translations.
+const phrases = require('./translations.json');
+const keys = Object.keys(phrases).sort((a, b) => b.length - a.length);
+function language() {
+  const locale = require('../stores/LocaleStore').getLocale();
+  return locale.startsWith('fr') ? 'fr' : locale.startsWith('en') ? 'en' : 'zh';
+}
+exports.t = function(text) {
+  const lang = language();
+  if (lang === 'zh') return text;
+  // One pass prevents a short phrase from re-translating a longer replacement.
+  const pattern = new RegExp(keys.map(key => key.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|'), 'g');
+  return text.replace(pattern, key => phrases[key][lang]);
+};
+exports.localizeDocument = function() {
+  if (language() === 'zh') return;
+  const walk = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
+  let node;
+  while ((node = walk.nextNode())) {
+    if (!['SCRIPT', 'STYLE'].includes(node.parentElement.tagName)) node.nodeValue = exports.t(node.nodeValue);
+  }
+  document.querySelectorAll('script[type="text/html"]').forEach(el => { el.textContent = exports.t(el.textContent); });
+  document.querySelectorAll('[aria-label], [placeholder]').forEach(el => {
+    ['aria-label', 'placeholder'].forEach(attr => { if (el.hasAttribute(attr)) el.setAttribute(attr, exports.t(el.getAttribute(attr))); });
+  });
+};
