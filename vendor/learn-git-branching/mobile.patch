new file mode 100644
index 0000000..625feb0
--- /dev/null
+++ b/src/js/visuals/graphCamera.js
@@ -0,0 +1,116 @@
+// Both local and origin papers share one camera, so repositories cannot overlap.
+class GraphCamera {
+  constructor(owner) {
+    this.owner = owner;
+    this.zoom = 1;
+    this.pan = { x: 0, y: 0 };
+    this.bindings = new Map();
+    const lang = document.documentElement.lang;
+    const copy = lang.startsWith('zh') ? ['缩小图形', '放大图形', '全图', '拖动查看'] :
+      lang.startsWith('fr') ? ['Réduire', 'Agrandir', 'Tout', 'Glisser pour déplacer'] :
+      ['Zoom out', 'Zoom in', 'Fit', 'Drag to pan'];
+    this.tools = document.createElement('div');
+    this.tools.className = 'pocket-graph-tools';
+    this.tools.setAttribute('role', 'group');
+    this.tools.setAttribute('aria-label', copy[3]);
+    [[ '−', copy[0], () => this.changeZoom(1 / 1.4) ],
+      [ '+', copy[1], () => this.changeZoom(1.4) ],
+      [ copy[2], copy[2], () => { this.zoom = 1; this.pan = { x: 0, y: 0 }; this.update(); } ]
+    ].forEach(([text, label, action]) => {
+      const button = document.createElement('button');
+      button.type = 'button'; button.textContent = text; button.setAttribute('aria-label', label);
+      button.addEventListener('click', action); this.tools.appendChild(button);
+    });
+    const hint = document.createElement('span'); hint.textContent = copy[3]; this.tools.appendChild(hint);
+    this.floating = owner.el.id === 'mainVisSpace';
+    if (this.floating) { this.tools.classList.add('pocket-graph-tools-floating'); this.tools.dataset.graphMain = ''; }
+    (this.floating ? document.body : owner.el).appendChild(this.tools);
+  }
+
+  changeZoom(factor) {
+    this.zoom = Math.max(1, Math.min(12, this.zoom * factor));
+    if (this.zoom === 1) this.pan = { x: 0, y: 0 };
+    this.update();
+  }
+
+  bind(vis) {
+    const svg = vis.paper.canvas;
+    if (this.bindings.has(svg)) return;
+    svg.classList.add('pocket-graph-canvas');
+    const points = this.points || (this.points = new Map());
+    const center = () => {
+      const p = [...points.values()];
+      return { x: p.reduce((s, v) => s + v.x, 0) / p.length, y: p.reduce((s, v) => s + v.y, 0) / p.length,
+        distance: p.length > 1 ? Math.hypot(p[0].x - p[1].x, p[0].y - p[1].y) : 0 };
+    };
+    const down = e => {
+      if ((!this.owner.shown && !this.owner.originVis?.shown) || e.button !== 0 || e.target.closest('.pocket-graph-tools')) return;
+      e.stopPropagation();
+      points.set(e.pointerId, { x: e.clientX, y: e.clientY });
+      this.lastPointer = center(); this.dragging = false; this.suppressClick = false;
+    };
+    const move = e => {
+      if (!points.has(e.pointerId)) return;
+      points.set(e.pointerId, { x: e.clientX, y: e.clientY });
+      const next = center(), dx = next.x - this.lastPointer.x, dy = next.y - this.lastPointer.y;
+      if (!this.dragging && points.size === 1 && Math.hypot(dx, dy) < 5) return;
+      this.dragging = true; this.suppressClick = true;
+      svg.setPointerCapture(e.pointerId);
+      e.stopPropagation();
+      if (next.distance && this.lastPointer.distance) this.zoom = Math.max(1, Math.min(12, this.zoom * next.distance / this.lastPointer.distance));
+      this.pan.x -= dx / this.scale; this.pan.y -= dy / this.scale;
+      this.lastPointer = next; this.update(); e.preventDefault();
+    };
+    const up = e => { points.delete(e.pointerId); if (points.size) this.lastPointer = center(); };
+    const click = e => { if (this.suppressClick) { e.preventDefault(); e.stopImmediatePropagation(); this.suppressClick = false; } };
+    [['pointerdown', down], ['pointermove', move], ['pointerup', up], ['pointercancel', up], ['click', click]].forEach(([name, fn]) => svg.addEventListener(name, fn, name === 'click'));
+    const background = vis === this.owner ? vis.el : null;
+    if (background) [['pointerdown', down], ['pointermove', move], ['pointerup', up], ['pointercancel', up]].forEach(([name, fn]) => background.addEventListener(name, fn));
+    this.bindings.set(svg, () => {
+      if (background) [['pointerdown', down], ['pointermove', move], ['pointerup', up], ['pointercancel', up]].forEach(([name, fn]) => background.removeEventListener(name, fn));
+      [['pointerdown', down], ['pointermove', move], ['pointerup', up], ['pointercancel', up], ['click', click]].forEach(([name, fn]) => svg.removeEventListener(name, fn, name === 'click'));
+    });
+  }
+
+  update() {
+    const owner = this.owner, local = owner.gitVisuals?.readableLayout;
+    if (!local || !owner.paper) return;
+    const origin = owner.originVis, remote = origin?.gitVisuals?.readableLayout;
