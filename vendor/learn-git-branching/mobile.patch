--- /dev/null
+++ b/scripts/package-mobile.cjs
@@ -0,0 +1,23 @@
+// Produce a genuinely portable HTML: one classic script, all locales/levels
+// inlined by Vite, embedded CSS/fonts, no fetch or ES modules for file://.
+const fs = require('node:fs');
+const path = require('node:path');
+const build = path.join(__dirname, '../build');
+const dist = path.join(__dirname, '../dist');
+fs.mkdirSync(dist, {recursive:true});
+let html = fs.readFileSync(path.join(build,'index.html'),'utf8');
+html = html.replace(/<script\b[^>]*\bsrc="([^"]+)"[^>]*><\/script>/g, (tag, src) => {
+  if (/^https?:/.test(src)) throw new Error('Unexpected external script: '+src);
+  const code = fs.readFileSync(path.join(build,src),'utf8').replace(/<\/script/gi,'<\\/script');
+  return '<script defer>'+code+'</script>';
+});
+html = html.replace(/<link\b[^>]*rel="stylesheet"[^>]*href="([^"]+)"[^>]*>/g, (_, src) => '<style>'+fs.readFileSync(path.join(build,src),'utf8')+'</style>');
+html = html.replace(/<link\b[^>]*rel="modulepreload"[^>]*>/g,'');
+const icon = fs.readFileSync(path.join(build,'assets/favicon.ico')).toString('base64');
+html = html.replace(/<link\b[^>]*rel="icon"[^>]*>/g, '<link rel="icon" href="data:image/x-icon;base64,'+icon+'">');
+// Inline classic scripts execute in source order, and the app bootstraps at DOM ready.
+fs.writeFileSync(path.join(dist,'index.html'),html);
+fs.writeFileSync(path.join(dist,'git-pocket-offline.html'),html);
+fs.writeFileSync(path.join(dist,'git-pocket-android-v2.html'),html);
+fs.copyFileSync(path.join(__dirname,'../LICENSE.md'),path.join(dist,'LICENSE.txt'));
+console.log('Portable HTML: '+(Buffer.byteLength(html)/1024/1024).toFixed(2)+' MB; includes all built-in levels/locales.');
