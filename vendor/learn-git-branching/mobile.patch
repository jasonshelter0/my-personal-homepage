+const createStorage = require('../src/js/util/storage').createStorage;
+describe('storage for local Android documents', function() {
+  it('survives a SecurityError from the localStorage property getter', function() {
+    const storage = createStorage(function() { throw new Error('SecurityError'); });
+    expect(storage.isPersistent()).toBe(false);
+    storage.setItem('progress', '{"intro1":true}');
+    expect(storage.getItem('progress')).toBe('{"intro1":true}');
+    storage.removeItem('progress');
+    expect(storage.getItem('progress')).toBe(null);
+  });
+  it('survives disabled writes and keeps progress in memory', function() {
+    const storage = createStorage(() => ({setItem() { throw new Error('QuotaExceededError'); }}));
+    storage.setItem('progress', 'complete');
+    expect(storage.getItem('progress')).toBe('complete');
+    expect(storage.isPersistent()).toBe(false);
+  });
+  it('keeps the latest value when writes start failing during a session', function() {
+    let blocked = false;
+    const data = {};
+    const storage = createStorage(() => ({
+      getItem(key) { return data[key] || null; },
+      setItem(key,value) { if (blocked) throw new Error('QuotaExceededError'); data[key] = value; },
+      removeItem(key) { delete data[key]; }
+    }));
+    expect(storage.isPersistent()).toBe(true);
+    storage.setItem('progress', 'old');
+    blocked = true;
+    storage.setItem('progress', 'new');
+    expect(storage.getItem('progress')).toBe('new');
+    expect(storage.isPersistent()).toBe(false);
+  });
+});
