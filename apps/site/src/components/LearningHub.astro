---
import { copy, href, type Locale } from '../lib/data';
import PytorchCourseMap from './PytorchCourseMap.astro';
import Icon from './Icon.astro';
import { learningCourses } from '../lib/learning-catalog';
const { locale } = Astro.props as { locale: Locale };
const t = copy[locale];
---

<article class="learn-hub">
  <a class="back-link" href={href(locale)}>
    <Icon name="back" size={16} />
    {t.home}
  </a>
  <p class="eyebrow">{t.learnEyebrow}</p>
  <h1 data-pagefind-meta="title">{t.learn}</h1>
  <p class="detail-summary">{t.learnIntro}</p>
  <PytorchCourseMap locale={locale} hero={true}/>
  {learningCourses.map((item, index) => {
    const course = item.copy[locale];
    return <section class="learn-placeholder" aria-labelledby={`learn-course-${index}`}>
      <span class="learn-status-dot" aria-hidden="true"></span>
      <h2 id={`learn-course-${index}`}><a href={href(locale, item.path)}>{course.title}</a></h2>
      <p>{course.summary}</p>
      <p>{course.detail}</p>
      <a class="text-link" href={href(locale, item.path)}>{course.read} <Icon size={16} /></a>
    </section>;
  })}
  <a class="text-link" href={href(locale, 'posts')}>
    {t.learnBrowse} <Icon size={16} />
  </a>
</article>
