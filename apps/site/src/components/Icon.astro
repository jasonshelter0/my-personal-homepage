---
import { socialIcon } from '../../../../shared/social-icons';

interface Props {
  name?: string;
  size?: number;
}
const { name = 'arrow', size = 20 } = Astro.props;
const social = socialIcon(name);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={social && !social.stroke ? 'currentColor' : 'none'}
  stroke={social && !social.stroke ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {social ? (
    <path d={social.path} />
  ) : name === 'search' ? (
    <>
      <circle cx="10.8" cy="10.8" r="6.8" />
      <path d="m16 16 5 5" />
    </>
  ) : name === 'close' ? (
    <path d="m6 6 12 12M6 18 18 6" />
  ) : name === 'back' ? (
    <path d="M20 12H4m6-6-6 6 6 6" />
  ) : name === 'arrow' ? (
    <path d="M6 18 18 6M6 6h12v12" />
  ) : (
    <>
      <circle cx="12" cy="12" r="9" />
      <ellipse cx="12" cy="12" rx="4" ry="9" />
      <path d="M3 12h18" />
    </>
  )}
</svg>
