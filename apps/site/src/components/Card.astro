---
import { entryHref, media, dateLabel, copy, type Entry, type Locale } from '../lib/data';
import IndexCard from './IndexCard.astro';
const {
  entry,
  locale,
  wide = false,
} = Astro.props as { entry: Entry; locale: Locale; wide?: boolean };
const content = entry.translations[locale],
  cover = media(entry.coverId),
  t = copy[locale];
---

<IndexCard
  href={entryHref(locale, entry)}
  title={content.title}
  summary={content.summary}
  image={cover?.path}
  imageAlt={cover?.alt[locale]}
  imageWidth={cover?.width || 600}
  imageHeight={cover?.height || 400}
  aside={
    entry.type === 'experience' ? entry.period : cover ? undefined : entry.date?.slice(0, 4) || '—'
  }
  asideKind={entry.type === 'experience' ? 'period' : 'year'}
  date={entry.type === 'post' ? entry.date : undefined}
  dateLabel={entry.type === 'post' ? dateLabel(entry.date, locale) : undefined}
  tags={entry.tags}
  tagsLabel={t.tags}
  kind={entry.type}
  wide={wide}
/>
