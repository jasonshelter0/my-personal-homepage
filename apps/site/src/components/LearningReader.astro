---
import { copy, href, LOCALES, type Locale } from '../lib/data';
import '../styles/learning-reader.css';
const { locale, path } = Astro.props as { locale: Locale; path: string };
const labels = {
  'zh-CN': { enter: '沉浸阅读', exit: '退出沉浸', full: '全屏', leaveFull: '退出全屏', hint: '隐藏个人介绍，展开学习内容', unavailable: '浏览器未能开启全屏，你仍可继续沉浸阅读。', tools: '阅读工具' },
  en: { enter: 'Immersive reading', exit: 'Exit immersive mode', full: 'Fullscreen', leaveFull: 'Exit fullscreen', hint: 'Hide the profile and expand the lesson', unavailable: 'Fullscreen is unavailable. You can continue in immersive reading mode.', tools: 'Reading tools' },
  fr: { enter: 'Lecture immersive', exit: 'Quitter le mode immersif', full: 'Plein écran', leaveFull: 'Quitter le plein écran', hint: 'Masquer le profil et agrandir le cours', unavailable: 'Le plein écran est indisponible. Vous pouvez continuer en lecture immersive.', tools: 'Outils de lecture' },
}[locale];
const t = copy[locale];
---
<div class="learning-reader" data-learning-reader hidden data-pagefind-ignore
  data-enter={labels.enter} data-exit={labels.exit} data-full={labels.full}
  data-leave-full={labels.leaveFull} data-unavailable={labels.unavailable}>
  <div class="reader-bar" role="group" aria-label={labels.tools}>
    <div class="reader-navigation">
      <a href={href(locale, 'learn')} class="reader-hub" aria-label={t.learn}><span aria-hidden="true">←</span><span class="reader-hub-label">{t.learn}</span></a>
      <nav class="reader-languages" aria-label={t.language}>
        {LOCALES.map((l) => <a href={href(l, path)} lang={l} hreflang={l} aria-current={l === locale ? 'page' : undefined}>{l === 'zh-CN' ? '中文' : l === 'en' ? 'EN' : 'FR'}</a>)}
      </nav>
      <button type="button" data-reader-search>{t.search}</button>
    </div>
    <div class="reader-actions">
      <button type="button" data-reader-toggle aria-pressed="false" aria-controls="site-profile" title={labels.hint}>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16m4-11 3 3-3 3"/></svg>
        <span data-reader-label>{labels.enter}</span>
      </button>
      <button type="button" data-reader-fullscreen hidden aria-pressed="false" aria-label={labels.full} title={labels.full}>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 3H3v6m12-6h6v6M3 15v6h6m12-6v6h-6"/></svg>
        <span data-fullscreen-label>{labels.full}</span>
      </button>
    </div>
  </div>
  <p class="reader-status" data-reader-status role="status" aria-live="polite"></p>
</div>
<script>
  import '../lib/learning-reader';
</script>
