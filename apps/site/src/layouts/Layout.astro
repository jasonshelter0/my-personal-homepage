---
import '../styles/global.css';
import { sectionTitle } from '../../../../shared/sections';
import {
  snapshot,
  copy,
  href,
  publicHref,
  withBase,
  withoutBase,
  LOCALES,
  localePath,
  siteUrl,
  safeUrl,
  media,
  type Locale,
} from '../lib/data';
import Icon from '../components/Icon.astro';
import ComplianceFooter from '../components/ComplianceFooter.astro';
import LearningReader from '../components/LearningReader.astro';
import { CURSOR_GLOW_RADIUS } from '../../../../shared/types';
interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  path?: string;
  home?: boolean;
  cover?: string;
  category?: string;
}
const {
  locale,
  title,
  description,
  path = '',
  home = false,
  cover,
  category = 'page',
} = Astro.props;
const t = copy[locale],
  settings = snapshot.settings,
  profile = settings.profile[locale];
const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — ${profile.headline}`;
const canonical = siteUrl + publicHref(locale, path);
const accent = /^#[0-9a-f]{6}$/i.test(settings.accent) ? settings.accent : '#5eead4';
const glowRGB = [1, 3, 5]
  .map((offset) => parseInt(accent.slice(offset, offset + 2), 16))
  .join(', ');
const background = /^#[0-9a-f]{6}$/i.test(settings.background) ? settings.background : '#0f172a';
const glowRadius =
  Number.isInteger(settings.cursorGlowRadius) &&
  settings.cursorGlowRadius >= CURSOR_GLOW_RADIUS.min &&
  settings.cursorGlowRadius <= CURSOR_GLOW_RADIUS.max
    ? settings.cursorGlowRadius
    : CURSOR_GLOW_RADIUS.default;
const avatar = media(settings.avatarId);
const ProfileHeading = home ? 'h1' : 'span';
const learningPage = path === 'learn' || path.startsWith('learn/');
---

<!doctype html>
<html
  lang={locale}
  data-reader-page={learningPage ? '' : undefined}
  style={`--accent:${accent};--background:${background};--glow-rgb:${glowRGB};--glow-radius:${glowRadius}px`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={background} />
    {learningPage && <script is:inline>
      try {
        document.documentElement.dataset.readerMode = localStorage.getItem('folio:learning:immersive') === '1' ? 'immersive' : 'normal';
      } catch { /* Keep the regular layout when storage is unavailable. */ }
    </script>}
    <title>{pageTitle}</title>
    <meta name="description" content={description || profile.seoDescription} />
    {siteUrl && (
      <>
        <link rel="canonical" href={canonical} />
        {LOCALES.map((l) => (
          <link rel="alternate" hreflang={l} href={siteUrl + publicHref(l, path)} />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={siteUrl + publicHref(settings.defaultLocale, path)}
        />
      </>
    )}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description || profile.seoDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    {siteUrl && <meta property="og:url" content={canonical} />}
    {cover && siteUrl && <meta property="og:image" content={siteUrl + withoutBase(cover)} />}
    <link
      rel="alternate"
      type="application/rss+xml"
      href={withBase(`/${localePath(locale)}/rss.xml`)}
      title={`${profile.name} — ${t.writing}`}
    />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  </head>
  <body data-locale={locale}>
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    <div class="cursor-glow" aria-hidden="true"></div>
    <div class="site-shell">
      <header
        id="site-profile"
        class:list={[
          'profile-panel',
          {
            'profile-panel--with-portrait': avatar,
            'profile-panel--expanded':
              home && settings.sections.filter((s) => s.enabled).length > 6,
          },
        ]}
        data-pagefind-ignore
      >
        <div>
          <a class="brand-mark" href={href(locale)} aria-label={`${profile.name} — ${t.home}`}>
            <span class="brand-dot"></span> {t.theme}
          </a>
          {avatar && (
            <div class="profile-portrait">
              <img
                class="avatar"
                src={avatar.path}
                width="128"
                height="128"
                alt={avatar.alt[locale]}
                decoding="async"
              />
            </div>
          )}
          <a class="name-link" href={href(locale)}>
            <ProfileHeading class="profile-name">
              {profile.name}
              <span class="name-period">.</span>
            </ProfileHeading>
          </a>
          <p class="headline">{profile.headline}</p>
          <p class="intro">{profile.intro}</p>
          <nav class="section-nav" aria-label={t.toc}>
            {home ? (
              settings.sections
                .filter((s) => s.enabled)
                .map((s) => (
                  <a href={`#${s.id}`} data-nav={s.id}>
                    <span class="nav-line"></span>
                    <span>{sectionTitle(s, locale)}</span>
                  </a>
                ))
            ) : (
              <>
                <a href={href(locale)}>
                  <Icon name="back" size={16} />
                  <span>{t.home}</span>
                </a>
                <a
                  href={href(locale, 'projects')}
                  aria-current={path === 'projects' ? 'page' : undefined}
                >
                  {t.projects}
                </a>
                <a
                  href={href(locale, 'posts')}
                  aria-current={path === 'posts' ? 'page' : undefined}
                >
                  {t.writing}
                </a>
                <a
                  href={href(locale, 'pages')}
                  aria-current={path === 'pages' ? 'page' : undefined}
                >
                  {t.pages}
                </a>
              </>
            )}
            <a
              href={href(locale, 'learn')}
              aria-current={path === 'learn' || path.startsWith('learn/') ? 'page' : undefined}
            >
              <span>{t.learn}</span>
            </a>
          </nav>
        </div>
        <div class="profile-bottom">
          <div class="social-links">
            {settings.socials.map((s) => (
              <a
                href={safeUrl(s.url)}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${s.label} (${t.external})`}
                title={s.label}
              >
                <Icon name={s.icon} size={23} />
              </a>
            ))}
          </div>
          <div class="controls">
            <nav class="languages" aria-label={t.language}>
              {LOCALES.map((l) => (
                <a
                  href={href(l, path)}
                  lang={l}
                  hreflang={l}
                  aria-current={l === locale ? 'page' : undefined}
                >
                  {l === 'zh-CN' ? '中文' : l === 'en' ? 'EN' : 'FR'}
                </a>
              ))}
            </nav>
            <button class="search-trigger" type="button" aria-label={t.search} data-open-search>
              <Icon name="search" size={17} />
              <span>{t.search}</span>
              <kbd data-search-shortcut>Ctrl / ⌘ K</kbd>
            </button>
          </div>
        </div>
      </header>
      <main
        id="main"
        tabindex="-1"
        class:list={['main-content', { 'inner-content': !home }]}
        data-pagefind-body
        data-pagefind-filter={`type:${category}`}
      >
        {learningPage && <LearningReader locale={locale} path={path} />}
        <slot />
      </main>
      <footer class="site-footer" data-pagefind-ignore>
        <a href={href(locale, 'pages')}>
          {t.allPages} <span aria-hidden="true">↗</span>
        </a>
        <a class="site-notes-link" href={href(locale, 'site-notes')}>
          {t.siteNotes}
        </a>
      </footer>
    </div>
    <ComplianceFooter />
    <dialog
      id="search-dialog"
      class="search-dialog"
      aria-label={t.search}
      data-pagefind-ignore
      data-loading={t.searchLoading}
      data-empty={t.searchEmpty}
      data-unavailable={t.searchUnavailable}
      data-hint={t.searchHint}
      data-count={t.resultCount}
    >
      <div class="search-box">
        <Icon name="search" />
        <label class="sr-only" for="search-input">
          {t.search}
        </label>
        <input
          id="search-input"
          type="search"
          autocomplete="off"
          placeholder={t.searchPlaceholder}
        />
        <button type="button" class="icon-button" data-close-dialog aria-label={t.close}>
          <Icon name="close" />
        </button>
      </div>
      <div class="search-filters" role="group" aria-label={t.search}>
        {[
          ['', t.all],
          ['project', t.projects],
          ['post', t.writing],
          ['page', t.pages],
        ].map(([value, label]) => (
          <button
            type="button"
            data-search-filter={value}
            aria-pressed={value === '' ? 'true' : 'false'}
          >
            {label}
          </button>
        ))}
      </div>
      <p id="search-status" role="status" aria-live="polite">
        {t.searchHint}
      </p>
      <div id="search-results" role="list" aria-label={t.results}></div>
      <p class="search-shortcut" data-search-shortcut-template={t.searchKeyboard}>
        {t.searchKeyboard.replace('{shortcut}', 'Ctrl / ⌘ K')}
      </p>
    </dialog>
    <dialog id="image-dialog" class="image-dialog" aria-label={t.openImage} data-pagefind-ignore>
      <button type="button" class="icon-button" data-close-dialog aria-label={t.close}>
        <Icon name="close" />
      </button>
      <figure>
        <img src="" alt="" />
        <figcaption></figcaption>
      </figure>
    </dialog>
    <script>
      import '../lib/interactions';
    </script>
  </body>
</html>
