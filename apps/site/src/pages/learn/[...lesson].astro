---
import { href, snapshot } from '../../lib/data';
import { allLearningPaths } from '../../lib/learning-catalog';
export function getStaticPaths() {
  return allLearningPaths.map((path) => ({
    params: { lesson: path.slice('learn/'.length) }, props: { path },
  }));
}
const url = href(snapshot.settings.defaultLocale, Astro.props.path);
---
<!doctype html>
<html lang={snapshot.settings.defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${url}`} />
    <title>学习 · Learning · Apprentissage</title>
  </head>
  <body>
    <a href={url}>学习 · Learning · Apprentissage →</a>
    <script define:vars={{ url }}>
      location.replace(url);
    </script>
  </body>
</html>
