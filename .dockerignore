# Allow only runtime source, installed Linux dependencies and the admin bundle.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!node_modules/
!node_modules/**
!server/
!server/**
!shared/
!shared/**
!scripts/
!scripts/**
!apps/
!apps/site/
!apps/site/**
!apps/admin/
!apps/admin/dist/
!apps/admin/dist/**
!deploy/
!deploy/container-entrypoint.sh
node_modules/.cache/
node_modules/.vite-temp/
node_modules/.vite/
node_modules/.astro/
apps/site/.astro/
apps/site/dist/
apps/site/node_modules/
**/.env
**/.env.*
**/*.log
